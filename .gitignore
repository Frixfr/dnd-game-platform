```gitignore
# Dependencies
node_modules/

# Build outputs
dist/
build/
*.js.map
*.ts.map

# Logs
*.log

# Environment variables
.env
.env.local
*.env.*

# Editor files
.vscode/
.idea/
*.swp
*.swo
*.tmp

# OS generated files
.DS_Store
Thumbs.db

# Coverage reports
coverage/
htmlcov/
.coverage

# Python specific
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
*.so
.Pytest_cache/

# Node.js specific
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Compiled files
*.o
*.obj
*.exe
*.dll
*.so
*.a
*.out
```