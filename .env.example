# Порт, на котором будет запущен сервер (бэкенд)
PORT=5000

# Хост для сервера (по умолчанию localhost)
HOST=localhost

# Адрес фронтенд-клиента (для CORS)
CLIENT_ORIGIN=http://localhost:3000

# --- Клиент (Vite, копируется в client/.env.local) ---
# Адрес бэкенда для dev-прокси Vite (/api, /uploads, /socket.io).
# Замените на IP/хост машины, где запущен сервер, например http://192.168.1.50:5000
VITE_BACKEND_URL=http://localhost:5000

# Базовый URL REST API. Оставьте "/api" — тогда запросы идут через
# прокси Vite (конфликт с baseURL исключён). Абсолютный URL задавайте
# только при работе без прокси.
VITE_API_URL=/api

# Базовый URL сокет-сервера. Пустое значение = тот же origin, что и
# страница (через прокси Vite). При обходе прокси укажите адрес бэкенда,
# например ws://192.168.1.50:5000
# VITE_SOCKET_URL=